{
    "app-id": "com.spacepods.ui",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "spacepods-ui",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--socket=system-bus",
        "--filesystem=/tmp"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/spacepods-ui/cargo"
        }
    },
    "modules": [
        {
            "name": "spacepods-ui",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --bin spacepods-ui",
                "install -Dm755 target/release/spacepods-ui /app/bin/spacepods-ui",
                "install -Dm644 spacepods-ui/resources/app-icon.svg /app/share/icons/hicolor/scalable/apps/com.spacepods.ui.svg",
                "install -Dm644 spacepods-ui/data/com.spacepods.ui.desktop /app/share/applications/com.spacepods.ui.desktop",
                "install -Dm644 spacepods-ui/data/com.spacepods.ui.metainfo.xml /app/share/metainfo/com.spacepods.ui.metainfo.xml"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
